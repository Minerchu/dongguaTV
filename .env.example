# 复制为 .env 后按需修改；Docker / 面板部署可直接配置环境变量
PORT=3000

# Docker Compose 对外访问端口（宿主机端口；容器内部仍为 3000）
HOST_PORT=3000

# 可选：启用自带 Caddy HTTPS 时填域名，例如 tv.example.com
# 同时执行 docker compose -f docker-compose.yml -f docker-compose.https.yml up -d --build
DOMAIN=

# 采集站 PING 巡检，0 表示关闭；默认每 10 分钟一次
HEALTH_CHECK=1

# 后台管理员密码（务必修改）
ADMIN_PASSWORD=admin

# 后台 IP 白名单，逗号分隔；留空表示不限制。
# 只允许服务器本机访问后台时填 loopback，再通过 SSH 隧道访问。
# 示例：ADMIN_ALLOWED_IPS=loopback,203.0.113.10
ADMIN_ALLOWED_IPS=

# 默认只允许本站同源页面调用 API。确需给另一个前端跨域使用时，填写完整 Origin。
# 示例：API_ALLOWED_ORIGINS=https://app.example.com
API_ALLOWED_ORIGINS=

# 只有部署在 Nginx / Caddy / 宝塔等反向代理后面时才设为 1，用于识别真实客户端 IP。
# 直接映射端口时保持为空，避免伪造 X-Forwarded-For。
TRUST_PROXY=

# TMDb 凭据二选一。推荐直接在后台「系统设置」填写，后台配置优先于这里。
# 短的 API Key（32 位）
TMDB_API_KEY=
# 长的 API Read Access Token（eyJ 开头）；填了这个可以不填 TMDB_API_KEY
TMDB_READ_TOKEN=

# 推荐：服务器无法直连 TMDb 时，直接在后台「系统设置」填写反代根地址，无需重启。
# Cloudflare Worker 示例：examples/cloudflare-tmdb-worker.mjs
# 下面三项是备用方案；后台反代地址优先于它们。
# TMDB_API_BASE=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# 默认会自动切换备用域名，以下两项通常不需要设置
# TMDB_API_FALLBACK=https://api.tmdb.org/3
# TMDB_IMAGE_FALLBACK=https://www.themoviedb.org/t/p
# TMDB_TIMEOUT=15000
# TMDB_LANGUAGE=zh-CN

# 可选：给 TMDb 出站请求配置代理（Docker 内通常用 host.docker.internal）
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890

# 网盘搜索（PanSou），不需要可留空
PANSOU_URL=
PANSOU_TOKEN=
# 如果 PanSou 开了认证，也可以填账号密码自动换 Token
PANSOU_USER=
PANSOU_PASS=

# 超时（毫秒）
SEARCH_TIMEOUT=6000
TEST_TIMEOUT=5000
PANSOU_TIMEOUT=15000
