# 复制为 .env 后按需修改；Docker / 面板部署可直接配置环境变量
PORT=3000

# 后台管理员密码（务必修改）
ADMIN_PASSWORD=admin

# TMDb API Key（必须；由服务端 /tmdb 代理使用，不会出现在前端）
TMDB_API_KEY=

# 可选：服务器无法直连 TMDb 时，改成你自己的反代地址
# TMDB_API_BASE=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# TMDB_TIMEOUT=15000
# TMDB_LANGUAGE=zh-CN

# 可选：给 TMDb 出站请求配置代理（Docker 内通常用 host.docker.internal）
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890

# 网盘搜索（PanSou），不需要可留空
PANSOU_URL=
PANSOU_TOKEN=
# 如果 PanSou 开了认证，也可以填账号密码自动换 Token
PANSOU_USER=
PANSOU_PASS=

# 超时（毫秒）
SEARCH_TIMEOUT=6000
TEST_TIMEOUT=5000
PANSOU_TIMEOUT=15000
